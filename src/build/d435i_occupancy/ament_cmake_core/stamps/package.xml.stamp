<?xml version="1.0"?>
<package format="3">
  <name>d435i_occupancy</name><version>0.1.0</version>
  <description>Fixed D435i camera probabilistic voxel occupancy mapping (librealsense native depth publisher)</description>
  <maintainer email="user@example.com">Workspace User</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>nav_msgs</depend><depend>std_msgs</depend><depend>visualization_msgs</depend><depend>librealsense2</depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend><exec_depend>rviz2</exec_depend>
  <test_depend>rclpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
