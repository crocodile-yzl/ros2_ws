Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: camera
    Background Color: 40; 40; 48
  Displays:
  - Class: rviz_default_plugins/Image
    Name: 标注图 (检测框)
    Enabled: true
    Topic:
      Value: /recognition/annotated
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Image
    Name: 原始彩色图 (/video)
    Enabled: true
    Topic:
      Value: /video
      Reliability Policy: Reliable
    Value: true
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
    Saved: ~
Window Geometry:
  Height: 700
  Width: 1200
